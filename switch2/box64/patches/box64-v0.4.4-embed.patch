--- a/src/include/custommem.h
+++ b/src/include/custommem.h
@@ -31,6 +31,22 @@ size_t customGetUsableSize(void* p);
 
 #ifdef DYNAREC
 #include "dynacache.h"
+
+// Split JIT (GR port). Translated code runs at its exec address and is written through a second
+// view at exec + box64_jit_wdelta: a mach_vm_remap alias on macOS, kaiHEN's staging buffer on
+// Horizon. The delta is 0 when code memory is plain RWX. Only the machine code, its table64, the
+// jmpnext stub and the dynablock_t* headers are read through the exec view; other block tables
+// are kept at write-view addresses. In BOX64_EMBED builds the host provides JitAllocChunk (exec
+// address of fresh code memory, never freed) and JitPublish (make written code visible and
+// executable at exec_addr).
+#ifndef JITW
+extern intptr_t box64_jit_wdelta;
+#define JITW(p) ((void*)((uintptr_t)(p) + box64_jit_wdelta))
+#endif
+#ifdef BOX64_EMBED
+void* JitAllocChunk(size_t size);
+void JitPublish(void* exec_addr, size_t size);
+#endif
 typedef struct dynablock_s dynablock_t;
 typedef struct mmaplist_s mmaplist_t;
 // custom protection flag to mark Page that are Write protected for Dynarec purpose
